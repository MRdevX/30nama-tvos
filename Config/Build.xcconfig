// Build settings that differ per machine. Real values go in Local.xcconfig, which is git-ignored:
// copy Local.example.xcconfig to Local.xcconfig and fill it in.
DEVELOPMENT_TEAM =
TMDB_TOKEN =
#include? "Local.xcconfig"

// What is written into the app. Anything inside an app can be read back out of it, so the token
// only goes into Debug builds, which stay on the developer's own machine. A Release build (archive,
// TestFlight, App Store) is made without it and has the trending rows off.
TMDB_TOKEN_IN_APP =
TMDB_TOKEN_IN_APP[config=Debug] = $(TMDB_TOKEN)
